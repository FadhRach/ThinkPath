# Bukan autentikasi. Mengisi ini memasukkan permintaan ke polite pool OpenAlex
# supaya tidak cepat kena pembatasan laju. Boleh dikosongkan.
OPENALEX_MAILTO=nama@example.com

# Dibutuhkan hanya untuk tahap generate sisi AI. Gratis di console.groq.com.
# Jalankan dengan --human-only kalau belum punya.
GROQ_API_KEY=

# Dibutuhkan hanya oleh evaluate_detector.py. Ambil di gowinston.ai ->
# dashboard API. Pendaftaran memberi 2.500 kredit gratis dan satu kredit
# terpakai per KATA, sedangkan gold set penuh sekitar 170.000 kata. Jadi pakai
# --limit kecil dan andalkan cache di data/cache/detector_scores.jsonl untuk
# menyambung setelah saldo diisi.
WINSTON_API_KEY=
