# Bukan autentikasi. Mengisi ini memasukkan permintaan ke polite pool OpenAlex
# supaya tidak cepat kena pembatasan laju. Boleh dikosongkan.
OPENALEX_MAILTO=nama@example.com

# Dibutuhkan hanya untuk tahap generate sisi AI. Gratis di console.groq.com.
# Jalankan dengan --human-only kalau belum punya.
GROQ_API_KEY=
