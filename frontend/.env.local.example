NEXT_PUBLIC_BACKEND_URL=http://localhost:7860

# Opsional. Zona waktu yang dipakai menampilkan seluruh jam dan tanggal.
# Dibiarkan kosong berarti Asia/Jakarta. Isi Asia/Makassar untuk WITA atau
# Asia/Jayapura untuk WIT. Jangan dikosongkan dengan harapan mengikuti
# peramban: nilainya menentukan tampilan di server maupun di klien, dan
# itu memang disengaja agar dosen dan mahasiswa membaca jam yang sama.
# NEXT_PUBLIC_DISPLAY_TIME_ZONE=Asia/Jakarta

# Token baca-tulis Vercel Blob, dipakai app/api/blob/upload-token untuk
# menerbitkan token unggah dokumen jawaban mahasiswa. Di deployment Vercel
# terisi otomatis begitu Blob store dihubungkan ke proyek ini (Storage ->
# Connect Store). Untuk dev lokal, ambil dengan `vercel env pull .env.local`
# atau salin manual dari dashboard proyek.
BLOB_READ_WRITE_TOKEN=
