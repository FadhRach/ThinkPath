DJANGO_SECRET_KEY=replace-me-with-a-random-50-char-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Umur token login (hari). Token ditandatangani DJANGO_SECRET_KEY.
AUTH_TOKEN_LIFETIME_DAYS=7

# API key Groq untuk analisis LLM (gratis di console.groq.com).
# Kosongkan untuk memakai analisis heuristik fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Detektor AI eksternal, dipakai untuk SKOR AI saja. Level Bloom tetap dari
# Groq atau heuristik, tidak pernah dari detektor.
#
# Penyedia sekarang Winston AI, dipilih karena mencantumkan bahasa Indonesia di
# daftar bahasa API-nya. Sapling sempat dicoba dan dibatalkan: detektornya
# English-only. Jangan mengganti penyedia tanpa memeriksa daftar bahasanya
# lebih dulu.
#
# Ambil kunci di gowinston.ai -> dashboard API. Pendaftaran memberi 2.500
# kredit gratis, dan satu kredit terpakai per KATA, bukan per permintaan.
#
# Kosongkan untuk memakai jalur lama (Groq lalu heuristik) persis seperti
# sebelumnya. Kalau kredit habis, Winston menjawab 402 dan sistem otomatis
# jatuh ke jalur lama tanpa menggagalkan pengumpulan tugas.
#
# JANGAN mengisi nilainya di berkas ini. Berkas .env.example DILACAK git,
# sedangkan .env tidak. Kunci asli hanya boleh ada di backend/.env.
WINSTON_API_KEY=

# Connection string Postgres Supabase (dashboard -> Connect -> Session pooler,
# port 5432). Ganti [YOUR-PASSWORD] dengan Database Password project.
# Kosongkan/komentari baris ini untuk fallback SQLite lokal (dev offline).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Umur koneksi DB persisten (detik). Default 0 = tutup tiap request (aman untuk
# batas 15 koneksi pooler Supabase free tier). Kalau worker sedikit (mis.
# gunicorn --workers 2), set 60 untuk memakai ulang koneksi & memangkas latency.
DB_CONN_MAX_AGE=0

# Model visual Groq untuk ekstraksi dokumen (OCR) pada academics/document_extraction.py.
# Dipakai hanya untuk halaman/gambar yang tidak punya lapisan teks native (hasil
# scan, foto, tulisan tangan) - PDF dengan teks native tidak pernah memanggil ini.
# Kosongkan berarti fitur upload dokumen menolak dengan pesan jelas, bukan crash.
# Verifikasi id model visual yang berlaku saat ini di konsol Groq sebelum mengisi.
GROQ_VISION_MODEL=

# Token baca-tulis Vercel Blob, dipakai document_extraction.fetch_blob untuk
# mengambil berkas yang diunggah mahasiswa. Ambil dari dashboard Vercel proyek
# frontend -> Storage -> Blob store yang sama dipakai route
# frontend/app/api/blob/upload-token.
BLOB_READ_WRITE_TOKEN=
