DJANGO_SECRET_KEY=replace-me-with-a-random-50-char-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Umur token login (hari). Token ditandatangani DJANGO_SECRET_KEY.
AUTH_TOKEN_LIFETIME_DAYS=7

# API key Groq untuk analisis LLM (gratis di console.groq.com).
# Kosongkan untuk memakai analisis heuristik fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Connection string Postgres Supabase (dashboard -> Connect -> Session pooler,
# port 5432). Ganti [YOUR-PASSWORD] dengan Database Password project.
# Kosongkan/komentari baris ini untuk fallback SQLite lokal (dev offline).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Umur koneksi DB persisten (detik). Default 0 = tutup tiap request (aman untuk
# batas 15 koneksi pooler Supabase free tier). Kalau worker sedikit (mis.
# gunicorn --workers 2), set 60 untuk memakai ulang koneksi & memangkas latency.
DB_CONN_MAX_AGE=0
