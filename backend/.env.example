# Salin ke .env lalu isi. Berkas .env TIDAK dilacak git; jangan menaruh nilai
# asli di berkas ini.
#
# Satu .env dipakai dua cara:
# - dev lokal tanpa Docker (make dev): bagian "Django" + "Analisis"
# - Docker di laptop/VPS (make up): semua bagian

# --- Django ------------------------------------------------------------------
# Wajib di produksi. Buat dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me
# Hanya berlaku untuk dev lokal; container produksi selalu DEBUG=False.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origin frontend. Produksi: https://thinkpath.vercel.app (tanpa garis miring akhir).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_TOKEN_LIFETIME_DAYS=7

# Kosong = SQLite lokal (backend/db.sqlite3) untuk dev tanpa Docker.
# Di Docker nilainya dirakit otomatis dari POSTGRES_* di bawah; jangan diisi.
DATABASE_URL=

# --- Analisis ----------------------------------------------------------------
# Kosongkan untuk memakai heuristik lokal saja. Kunci yang gagal/habis kredit
# otomatis jatuh ke lapisan berikutnya tanpa menggagalkan pengumpulan.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Detektor eksternal (skor AI saja, ditagih per KATA). Lihat
# apps/analysis/providers/winston.py sebelum mengganti penyedia.
WINSTON_API_KEY=

# --- Docker: Postgres, domain, proses ------------------------------------------
POSTGRES_DB=thinkpath
POSTGRES_USER=thinkpath
# Pakai karakter aman-URL saja (masuk ke DATABASE_URL). Buat dengan:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Subdomain API yang A-record-nya mengarah ke IP VPS, mis. api.thinkpath.id.
# "localhost" di laptop: Caddy memakai sertifikat lokal (curl -k).
API_DOMAIN=localhost
# Port loopback untuk akses langsung ke API tanpa Caddy (debug/frontend lokal).
API_HOST_PORT=8000

# 1 worker x 8 thread cukup untuk VPS 1 GB. Naikkan worker hanya bila RAM lega.
WEB_CONCURRENCY=1
GUNICORN_THREADS=8
LOG_LEVEL=INFO
