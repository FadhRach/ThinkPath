# Lokal (runserver + Postgres lokal). Salin: cp .env.example .env
# Produksi (VPS) pakai .env.production.example.

# Postgres lokal. macOS/Linux (Homebrew/apt): USER = user OS, PASSWORD kosong.
# Windows: USER=postgres, PASSWORD = password saat instalasi.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=thinkpath
POSTGRES_USER=
POSTGRES_PASSWORD=

# Analisis. Kosong = heuristik lokal saja.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Model visual untuk membaca dokumen scan/foto; kosong = bawaan di kode.
GROQ_VISION_MODEL=
WINSTON_API_KEY=
