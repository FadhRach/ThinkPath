DJANGO_SECRET_KEY=replace-me-with-a-random-50-char-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Postgres connection string dari Supabase (Settings -> Database -> Connection string).
# Pakai "Connection pooling" (port 6543) bila habis koneksi langsung.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# JWT secret dari Supabase (Settings -> API -> JWT Settings -> JWT Secret).
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
