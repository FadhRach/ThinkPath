# Lokal (runserver + Postgres lokal). Salin: cp .env.example .env
# Produksi (VPS) pakai .env.production.example.

# Kosong = postgres:///thinkpath (socket lokal, user OS, tanpa password).
# Windows / pakai password: postgres://postgres:PASSWORD@localhost:5432/thinkpath
DATABASE_URL=

# Analisis. Kosong = heuristik lokal saja.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
WINSTON_API_KEY=
