# Reverse proxy + HTTPS otomatis (Let's Encrypt) untuk API.
# API_DOMAIN diisi di .env (API_DOMAIN=localhost: sertifikat lokal, curl perlu -k).
{$API_DOMAIN:localhost} {
	encode zstd gzip

	# Unggah dokumen: 10 MB berkas + sedikit overhead multipart.
	@upload path /api/assignments/*/documents
	request_body @upload {
		max_size 11MB
	}

	# Jawaban esai + cuplikan proses jauh di bawah 2 MB.
	@json not path /api/assignments/*/documents
	request_body @json {
		max_size 2MB
	}

	header -Server

	reverse_proxy api:8000
}
