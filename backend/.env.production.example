# Produksi (VPS, Docker Compose). Di VPS: cp .env.production.example .env
# Uji Docker di Mac: cp ke .env.docker, API_DOMAIN=http://localhost, CORS http://localhost:3000

# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Subdomain API (A record -> IP VPS) dan origin frontend, tanpa garis miring akhir.
API_DOMAIN=thinkpath.fadh.tech
CORS_ALLOWED_ORIGINS=https://thinkpath.vercel.app

# Postgres di container. Password huruf+angka saja: openssl rand -hex 24
POSTGRES_DB=thinkpath
POSTGRES_USER=thinkpath
POSTGRES_PASSWORD=

# Analisis. Kosong = heuristik lokal saja.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Model visual untuk membaca dokumen scan/foto; kosong = bawaan di kode.
GROQ_VISION_MODEL=
WINSTON_API_KEY=
